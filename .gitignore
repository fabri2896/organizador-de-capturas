# Organizador de Capturas - .gitignore

# Arquivos de configuração do usuário
config.json

# Logs
*.log
organizador.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Pastas de capturas organizadas (exemplo - descomente se necessário)
# 2024/
# 2025/
# 2026/

# Arquivos temporários
*.tmp
*.bak
*.cache

# Arquivos de teste individuais na raiz (nao versionar)
test_*.py

# Pasta de testes unitarios (versionar)
!tests/

# PyInstaller
*.spec
build/
dist/
dist-nuitka/

# Inno Setup
Output/
*.exe

# Arquivos compilados (não versionar binários)
*.zip
*.tar.gz
